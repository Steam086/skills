{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pro response 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "based_on_export_id", "based_on_snapshot_id", "response_id", "summary", "facts", "proposals", "design_options", "codex_tasks", "risks_constraints", "open_questions", "next_sync"],
  "properties": {
    "protocol_version": {"const": "pro-handoff/1.0"},
    "session_id": {"$ref": "#/$defs/id"},
    "based_on_export_id": {"$ref": "#/$defs/id"},
    "based_on_snapshot_id": {"$ref": "#/$defs/hash"},
    "response_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
    "summary": {"$ref": "#/$defs/text"},
    "facts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/fact"}},
    "proposals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/proposal"}},
    "design_options": {"$ref": "#/$defs/strings"},
    "codex_tasks": {"$ref": "#/$defs/strings"},
    "risks_constraints": {"$ref": "#/$defs/strings"},
    "open_questions": {"$ref": "#/$defs/strings"},
    "next_sync": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 12000, "pattern": "\\S"},
    "strings": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/text"}},
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "detail"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/hash"},
        "detail": {"$ref": "#/$defs/text"}
      }
    },
    "fact": {
      "type": "object",
      "required": ["claim", "evidence"],
      "additionalProperties": false,
      "properties": {
        "claim": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "proposal": {
      "type": "object",
      "required": ["id", "recommendation", "rationale", "evidence", "conflicts_with"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
        "recommendation": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/evidence"}},
        "conflicts_with": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"}}
      }
    }
  }
}
